[Unit]
Description=Inkstone writing terminal bridge
After=network.target

[Service]
Type=simple
User=inkstone-terminal
Group=inkstone-terminal
WorkingDirectory=/opt/inkstone
Environment=HOME=/var/lib/inkstone-terminal
Environment=PATH=/var/lib/inkstone-terminal/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/inkstone-terminal.env
ExecStart=/usr/bin/node /opt/inkstone/scripts/local-terminal.mjs --origin ${INKSTONE_TERMINAL_ORIGIN} --workspace /var/lib/inkstone-terminal/writing
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inkstone-terminal

[Install]
WantedBy=multi-user.target
